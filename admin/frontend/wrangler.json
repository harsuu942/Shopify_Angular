{
  "name": "theheatingandplumbing-admin",
  "main": "worker.js",
  "compatibility_date": "2026-11-13",
  "build": {
    "command": "pnpm run build"
  },
  "assets": {
    "directory": "./dist/admin",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/actuator/*"]
  }
}
